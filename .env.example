# Copy to .env and fill in. .env is gitignored - never commit real keys.
#
# Carried over from the 22-Aug FlytBase hackathon repo, with the notes that were
# earned the hard way there kept intact. The four model providers are
# interchangeable providers INSIDE our own pipeline (captioning / VQA / label
# generation) - unrelated to how Claude Code itself is authenticated.
# `python scripts/check_setup.py` tests whichever keys are present, skips the rest.

# build.nvidia.com -> any vision model page -> "Get API Key". ~40 req/min free, no card.
# NOTE (22-Aug): meta/llama-3.2-90b-vision-instruct (the prereqs guide's example) hung
# indefinitely - key/network/catalog all verified fine via raw curl, that specific
# endpoint just never responded, likely because every team follows the same guide.
# Use meta/llama-3.2-11b-vision-instruct instead (<1s, and a better fit for bulk work).
# GET /v1/models lists what is actually live if that one dies too.
NVIDIA_API_KEY=nvapi-...

# aistudio.google.com -> Get API key. Accepts raw video directly, no frame extraction.
# Best used here as the teacher model for distillation / pseudo-labelling the
# unannotated footage, and as a query-time fallback - NOT in the runtime detector
# (the PS explicitly bars hosted models from being part of what makes it work at runtime).
# Free tier is Flash / Flash-Lite only; Pro needs billing. Limits are per project, not per key.
GEMINI_API_KEY=...

# openrouter.ai -> API Keys. Free-model availability rotates:
# https://openrouter.ai/models?max_price=0
OPENROUTER_API_KEY=sk-or-v1-...

# console.groq.com -> API Keys. Fast, free tier, vision-capable Llama models.
GROQ_API_KEY=gsk_...

# Handed out ON hackathon day: fill the form -> WhatsApp the number -> key for
# OpenAI gpt-5.6-luna. Hard-limited to ~4 RPM, so treat it as a spot-check /
# eval-judge key, never a bulk-labelling one.
AIGRANTS_OPENAI_API_KEY=

# kaggle.com -> Settings -> API -> Create New Token.
# NOTE: this CLI version (2.2.4) uses a SINGLE token, not the classic
# kaggle.json username+key pair older docs describe. The KGAT_-prefixed token must
# live in ~/.kaggle/access_token (or KAGGLE_API_TOKEN) for the `kaggle` CLI itself.
# See docs/KAGGLE.md for the full workflow and every bug hit last time.
KAGGLE_USERNAME=...
KAGGLE_API_TOKEN=...

# huggingface.co -> Settings -> Access Tokens. Read-only scope is enough (we only
# pull public weights). Removes the unauthenticated rate-limit warnings.
HF_TOKEN=hf_...

# --- dataset ---------------------------------------------------------------
DATA_ROOT=./data

# Five Drive mirrors of the SAME ~15-17GB train+test pack (from the dataset doc).
# scripts/download_dataset.py walks them in order and falls through on Google's
# anonymous-download quota - which is precisely what blocked us on 22-Aug.
AHC_DRIVE_MIRROR_1=https://drive.google.com/drive/folders/1sEFKR7ctd5GfFw-nMlYd_MnTw1VVYz9K
AHC_DRIVE_MIRROR_2=https://drive.google.com/drive/folders/13E_CePn14lcbwMA_yZEiHpAVx6i09UIG
AHC_DRIVE_MIRROR_3=https://drive.google.com/drive/folders/13V8JqgZRMzn2TCF0HTsCqVgUH0UOMmpb
AHC_DRIVE_MIRROR_4=https://drive.google.com/drive/folders/1fS_i7QKXRDI6mnaI6UWqYzKSOYWG8rFv
AHC_DRIVE_MIRROR_5=https://drive.google.com/drive/folders/1efhUZhB6Kyvpw3RulZJSwd0brb8KhuZf

# Keeps multi-GB HF weights on D: next to the data instead of filling C:.
HF_HOME=./models/hf

# --- persistent Kaggle GPU session (see docs/KAGGLE_REMOTE.md) --------------
# URL is printed by the server cell each session; token is yours, set it once in
# both .env and Kaggle Add-ons -> Secrets. `python scripts/remote.py token` mints one.
KAGGLE_REMOTE_URL=
KAGGLE_REMOTE_TOKEN=

# Windows cannot create the HF cache symlinks without Developer Mode or an
# elevated shell (WinError 1314, and it fails *after* downloading the bytes).
# Copying instead costs a little disk and avoids elevating anything.
HF_HUB_DISABLE_SYMLINKS=1
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# The test/ subfolder inside mirror 1, captured from gdown's own folder listing.
# Lets --test-only pull the 34 public test videos without the 15GB train pack.
AHC_TEST_FOLDER_ID=1m3UCdbgCfJ7gH4wuVG4ZhpKXx680j7ae
