# --- secrets ---
.env
kaggle.json
.kaggle/

# --- python ---
__pycache__/
*.pyc
.venv/
.ruff_cache/
.pytest_cache/
*.egg-info/

# --- node ---
node_modules/
web/dist/
web/.vite/

# --- the 15-17GB train/test pack and anything derived from it ---
data/
# --- the 1.33GB private evaluation pack (E001-E028), mirrored on Kaggle ---
eval/
models/hf/
models/*.pt
models/*.safetensors
models/*.onnx
models/*.engine

# --- run artefacts ---
runs/
outputs/
checkpoints/
wandb/
*.parquet
*.faiss
*.npy
*.npz
# ...except deliberate artifacts. artifacts/ holds things that are expensive to
# recreate and cheap to store - the training embeddings there cost a 40-minute
# GPU pass and 6 MB, so they belong in the repo rather than being regenerated
# on every fresh Kaggle session.
!artifacts/**

# --- media ---
*.mp4
*.mkv
*.avi
*.mov
*.srt

# --- papers: PDFs and extracted text are re-downloadable, notes are not ---
papers/*.pdf
papers/raw/

# --- kaggle notebook outputs pulled back down ---
kaggle/*/output/
kaggle/*/output_v*/
kaggle/*/results/

# --- organizer PDF: unclear redistribution rights, not needed to run the code ---
AHC Visual Intelligence Hackathon.pdf
